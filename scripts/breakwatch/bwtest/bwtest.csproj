<Project Sdk="Microsoft.NET.Sdk">
  <!-- The break watch's replay harness: PRISM's own BreakModel / LearnedBreak run over kept recordings (diagnostics/golden/<day>).
       Makes the trainer's readings (FEATCSV), checks an exported model against Python (LMODEL + LPARITY), and replays a detector's covers
       for an exam (LMODEL + LCALLS; scripts/breakwatch/exam.py scores them). See scripts/breakwatch/exams.md. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../targets/win-host/PrismHost/Services/BreakModel.cs" />
    <Compile Include="../../../targets/win-host/PrismHost/Services/AdPrints.cs" />
    <Compile Include="../../../targets/win-host/PrismHost/Services/AdSounds.cs" />
    <Compile Include="../../../targets/win-host/PrismHost/Services/LearnedBreak.cs" />
    <Compile Include="../../../targets/win-host/PrismHost/Services/PictureNet.cs" />
    <Compile Include="../../../targets/win-host/PrismHost/Services/FrameHash.cs" />
    <Compile Include="../../../targets/win-host/PrismHost/Services/AudioLandmarks.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />   <!-- the bench only (2026-11-08): MP3 to PCM for the fingerprinter's prototype -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />   <!-- the bench only (2026-11-08): the end verifier's cost a call; the host carries no runtime -->
  </ItemGroup>
</Project>
