<Window x:Class="PrismWebView2Poc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Prism WebView2 POC — DRM tile switching" Width="1600" Height="950"
        Background="#14171C">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8">
            <Button x:Name="BtnNetflixHero" Content="Netflix hero" Padding="14,6" Margin="0,0,8,0" Click="NetflixHero_Click"/>
            <Button x:Name="BtnHuluHero" Content="Hulu hero" Padding="14,6" Margin="0,0,8,0" Click="HuluHero_Click"/>
            <Button x:Name="BtnSwap" Content="Swap" Padding="14,6" Margin="0,0,8,0" Click="Swap_Click"/>
            <TextBlock x:Name="HeroLabel" Text="hero: none (50/50)" Foreground="#F0A83C" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- the two tiles -->
        <Grid Grid.Row="1" x:Name="Tiles">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="1*"/>
                <ColumnDefinition x:Name="ColRight" Width="1*"/>
            </Grid.ColumnDefinitions>
            <wv2:WebView2 x:Name="ViewNetflix" Grid.Column="0" Margin="4,0,2,0"/>
            <wv2:WebView2 x:Name="ViewHulu" Grid.Column="1" Margin="2,0,4,0"/>
        </Grid>

        <!-- status strip -->
        <StackPanel Grid.Row="2" Margin="10,6,10,8">
            <TextBlock x:Name="StatusNetflix" Text="netflix: initialising…" Foreground="#F2F4F7" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusHulu" Text="hulu: initialising…" Foreground="#F2F4F7" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
