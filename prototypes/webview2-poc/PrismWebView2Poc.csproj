<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <AssemblyName>PrismWebView2Poc</AssemblyName>
    <RootNamespace>PrismWebView2Poc</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Evergreen WebView2 runtime (system-installed), never Fixed Version -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
