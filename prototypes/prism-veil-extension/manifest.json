{
  "manifest_version": 3,
  "name": "PRISM",
  "version": "0.9.88",
  "description": "Ads become art. PRISM covers the ads on a page with pictures you chose. It clicks nothing and blocks nothing from loading.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ima-hook.js",
        "src/core-popups.js",
        "popup-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false,
      "exclude_matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube-nocookie.com/embed/*",
        "*://player.twitch.tv/*",
        "*://player.vimeo.com/video/*",
        "*://www.dailymotion.com/embed/*",
        "*://static.foxnews.com/static/orion/html/video/iframe/*"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/popups-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "exclude_matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube-nocookie.com/embed/*",
        "*://player.twitch.tv/*",
        "*://player.vimeo.com/video/*",
        "*://www.dailymotion.com/embed/*",
        "*://static.foxnews.com/static/orion/html/video/iframe/*"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/art.js",
        "src/art-credits.js",
        "src/dom.js",
        "src/ai-tiles.js",
        "src/rules-pack.js",
        "src/rules.js",
        "src/covers.js",
        "src/video.js",
        "src/sound-ads.js",
        "src/report.js",
        "src/marks.js",
        "src/core-reclaimed.js",
        "src/core-popups-iso.js",
        "src/popups-ui.js",
        "src/inpage-pops.js",
        "src/reclaimed-ui.js",
        "src/main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "exclude_matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube-nocookie.com/embed/*",
        "*://player.twitch.tv/*",
        "*://player.vimeo.com/video/*",
        "*://www.dailymotion.com/embed/*",
        "*://static.foxnews.com/static/orion/html/video/iframe/*"
      ]
    },
    {
      "matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube-nocookie.com/embed/*",
        "*://player.twitch.tv/*",
        "*://player.vimeo.com/video/*",
        "*://www.dailymotion.com/embed/*",
        "*://static.foxnews.com/static/orion/html/video/iframe/*"
      ],
      "js": [
        "ima-hook.js",
        "src/core-popups.js",
        "popup-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube-nocookie.com/embed/*",
        "*://player.twitch.tv/*",
        "*://player.vimeo.com/video/*",
        "*://www.dailymotion.com/embed/*",
        "*://static.foxnews.com/static/orion/html/video/iframe/*"
      ],
      "js": [
        "src/art.js",
        "src/art-credits.js",
        "src/dom.js",
        "src/ai-tiles.js",
        "src/rules-pack.js",
        "src/rules.js",
        "src/covers.js",
        "src/video.js",
        "src/report.js",
        "src/marks.js",
        "src/core-reclaimed.js",
        "src/core-popups-iso.js",
        "src/popups-ui.js",
        "src/inpage-pops.js",
        "src/reclaimed-ui.js",
        "src/main.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://imasdk.googleapis.com/*"
      ],
      "js": [
        "src/ima-frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "art/*.jpg",
        "art/list.json",
        "popup.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabCapture",
    "offscreen"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://prism.entangled.world/*",
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_title": "PRISM - popups intercepted on this site (click for the settings)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
