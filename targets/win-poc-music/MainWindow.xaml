<Window x:Class="PrismMusicPoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prism music POC - Widevine audio in WebView2" Width="1700" Height="980"
        Background="#14171C" WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8">
            <Button Content="Spotify hero" Padding="14,6" Margin="0,0,8,0" Click="Hero_Click" Tag="spotify"/>
            <Button Content="Apple Music hero" Padding="14,6" Margin="0,0,8,0" Click="Hero_Click" Tag="apple-music"/>
            <Button Content="Pandora hero" Padding="14,6" Margin="0,0,8,0" Click="Hero_Click" Tag="pandora"/>
            <Button Content="Equal" Padding="14,6" Margin="0,0,16,0" Click="Hero_Click" Tag=""/>
            <Button Content="Hide/show Spotify" Padding="14,6" Margin="0,0,8,0" Click="Hide_Click" Tag="spotify"/>
            <Button Content="Hide/show Apple Music" Padding="14,6" Margin="0,0,8,0" Click="Hide_Click" Tag="apple-music"/>
            <Button Content="Hide/show Pandora" Padding="14,6" Margin="0,0,16,0" Click="Hide_Click" Tag="pandora"/>
            <Button Content="Run EME probe now" Padding="14,6" Margin="0,0,8,0" Click="Probe_Click"/>
            <Button Content="Open log folder" Padding="14,6" Margin="0,0,8,0" Click="Logs_Click"/>
            <TextBlock x:Name="HeroLabel" Text="equal thirds" Foreground="#F0A83C" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="Tiles">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Col0" Width="1*"/>
                <ColumnDefinition x:Name="Col1" Width="1*"/>
                <ColumnDefinition x:Name="Col2" Width="1*"/>
            </Grid.ColumnDefinitions>
        </Grid>

        <StackPanel Grid.Row="2" Margin="10,6,10,8">
            <TextBlock x:Name="Status0" Text="spotify: initialising..." Foreground="#F2F4F7" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="Status1" Text="apple-music: initialising..." Foreground="#F2F4F7" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="Status2" Text="pandora: initialising..." Foreground="#F2F4F7" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
