<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- §12: the shell is a launcher — posters resolve any app's icon/label,
         and launch tiles may target any installed package. Not a Play build. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- §28: self-update via PackageInstaller (silent as device owner). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- §11: list paired HID remotes for edit mode; pairing itself is the system UI. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- §14 private listening: AudioPlaybackCapture rides a MediaProjection in a foreground service. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- §26 over native apps: intermission scenery as an overlay window (user toggle). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- TV build (§12): runs on Android TV / Shield; touch never required. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Prism"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- §26 native-app observer (accessibility, user-enabled): reads declared
             streaming apps' UI for ad markers + Skip; acts only on a human's press. -->
        <service
            android:name=".PrismAccessibilityService"
            android:exported="false"
            android:label="Prism intermission"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service" />
        </service>
        <!-- §26 native, second signal: media sessions (title/duration/position) via
             notification access — a user toggle. Ignores notifications; observation only. -->
        <service
            android:name=".PrismMediaListener"
            android:exported="false"
            android:label="Prism intermission (media sessions)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- §14: the one capture mix; runs only while a phone is listening. -->
        <service
            android:name=".AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
